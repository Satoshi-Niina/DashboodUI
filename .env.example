NODE_ENV=development
PORT=8080

# Use an isolated local PostgreSQL database. Do not point this at production.
DATABASE_URL=

# Used when running in production with CLOUD_SQL_INSTANCE, or as a local fallback.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=common_db
CLOUD_SQL_INSTANCE=

# Generate a unique value for each environment.
JWT_SECRET=
# Required. Signing key for SSO launch tokens (HS256). Must be the same value as SHARED_SSO_SECRET
# of the apps (e.g. 02_operation-management-app). The server refuses to start when it is empty.
SHARED_SSO_SECRET=
JWT_ISSUER=dashboard-auth
JWT_AUDIENCE=dashboard-apps
SESSION_MAX_AGE_MS=14400000

# Tenant URL policy. In production, public tenant IDs may be enforced.
REQUIRE_PUBLIC_TENANT_ID=

# Optional only when the control-plane/routing database is separate from DATABASE_URL.
TENANT_ROUTING_DB_NAME=

# Example tenant configuration (specify tenant database name or connection URL)
TENANT_DB_DAITETSU_NAME=daitetsu_db
TENANT_DB_DAITETSU_URL=

# E2E Verification Test Settings (scripts/e2e_verify.cjs)
# Do NOT commit actual credentials to Git. Set these in your local .env or CI secrets.
E2E_USERNAME=
E2E_PASSWORD=
E2E_CERT_PASSPHRASE=
E2E_ALLOW_WRITE=true
E2E_CERTS_DIR=

