NODE_ENV=development
PORT=8080

# Use an isolated local PostgreSQL database. Do not point this at production.
DATABASE_URL=

# Used when running in production with CLOUD_SQL_INSTANCE, or as a local fallback.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=common_db
CLOUD_SQL_INSTANCE=

# Generate a unique value for each environment.
JWT_SECRET=
# Required. Signing key for SSO launch tokens (HS256). Must be the same value as SHARED_SSO_SECRET
# of the apps (e.g. 02_operation-management-app). The server refuses to start when it is empty.
SHARED_SSO_SECRET=
JWT_ISSUER=dashboard-auth
JWT_AUDIENCE=dashboard-apps
SESSION_MAX_AGE_MS=14400000

# Required. Shared secret for HMAC token signing between Gateway and backend services.
# The server refuses to start when it is empty.
INTERNAL_GATEWAY_SECRET=

# Tenant URL policy. In production, public tenant IDs may be enforced.
REQUIRE_PUBLIC_TENANT_ID=

# Optional only when the control-plane/routing database is separate from DATABASE_URL.
TENANT_ROUTING_DB_NAME=

# Example tenant configuration (specify tenant database name or connection URL)
TENANT_DB_DAITETSU_NAME=daitetsu_db
TENANT_DB_DAITETSU_URL=

# Planning app endpoint
URL_PLANNING=http://localhost:3002/planning

# ========================================
# Google Cloud Platform (GCP) Configuration
# ========================================
# GCP Project ID (e.g. maint-vehicle-management)
GOOGLE_CLOUD_PROJECT_ID=maint-vehicle-management
GOOGLE_CLOUD_PROJECT=maint-vehicle-management

# Cloud Storage Bucket Name (e.g. maint-vehicle-management-storage)
GOOGLE_CLOUD_STORAGE_BUCKET=maint-vehicle-management-storage
GCS_BUCKET_NAME=maint-vehicle-management-storage
STORAGE_MODE=gcs
GCS_KNOWLEDGE_FOLDER=ai-knowledge

# In Cloud Run production, leave this empty to use Application Default Credentials (ADC).
# In local development, specify relative or absolute path only if needed.
# GOOGLE_APPLICATION_CREDENTIALS=

